xarch="aarch64"
startup_addr="0x40080000"
startup_args="virtual=aarch64le,raw"
startup_cmd="../startup-qemu-virt"
hooks="rtc slogger2 fsevmgr devb-virtio rootfs devc-virtio devc-pty late-init"
hook_rtc_params="-b 0x9010000 primecell"
hook_pci_hw_module="pci_hw-fdt.so.3.1"
hook_devb_params="virtio smem=0xa003e00,irq=79"
hook_devc_params="0xa003800,76"
hook_late_init_random_params="-l devr-virtio.so:mem=0xa003c00 -vvvv"
hook_late_init_io_sock_params="-m fdt -d vtnet_mmio"
devc_console_path="/dev/vcon1"
init="/ifs/init/late_init"
