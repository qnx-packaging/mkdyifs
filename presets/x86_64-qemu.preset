arch="x86_64"
startup_addr="8m"
startup_args="virtual=x86_64,multiboot"
startup_cmd="startup-x86 -D8250..115200 -zz"
hooks="rtc slogger2 pci devb-virtio rootfs devc-virtio devc-pty late-init"
hook_pci_hw_module="pci_hw-Intel_x86.so"
hook_rtc_params="hw"
hook_devb_params=""
hook_devc_params="-e"
hook_late_init_random_params="-l devr-virtio.so -vvvv"
hook_late_init_io_sock_params="-m phy -m pci -d vtnet_pci"
devc_console_path="/dev/vcon1"
init="/ifs/init/late_init"
